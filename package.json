{
  "name": "mastergo-transcoder-gui",
  "version": "0.1.0",
  "private": true,
  "description": "MasterGo 设计稿转 MTSLG IOContorl / MW WPF 的本地客户端",
  "scripts": {
    "start": "node server.js",
    "api": "node server.js --no-open",
    "dev:ui": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-exclude=\"**/node_modules/**\" --test-coverage-lines=55 --test-coverage-functions=55 --test-coverage-branches=55 \"tests/*.test.js\""
  },
  "dependencies": {
    "openai": "^7.23.0"
  }
}
